# Copy values into Coolify → Application → Environment Variables
# Backend: https://backend.guildsystem.com.br

SPRING_PROFILES_ACTIVE=prod,discord
SPRING_DATASOURCE_URL=jdbc:postgresql://<postgres-service-host>:5432/guild_points
SPRING_DATASOURCE_USERNAME=guild
SPRING_DATASOURCE_PASSWORD=<strong-password>
JWT_SECRET=<256-bit-random-secret>
CORS_ORIGINS=https://blacklist.guildsystem.com.br
# Must match the frontend origin exactly (scheme + host, no trailing slash).
UPLOAD_PATH=/data/uploads
DISCORD_CLIENT_ID=<discord-app-client-id>
DISCORD_CLIENT_SECRET=<discord-app-client-secret>
OAUTH_FRONTEND_URL=https://blacklist.guildsystem.com.br

# Discord Developer Portal → OAuth2 → Redirects:
# https://backend.guildsystem.com.br/login/oauth2/code/discord

# Coolify: mount persistent volume at /data/uploads on the backend container
