# Copy values into Coolify → Application → Environment Variables
# Replace seudominio.com with your domain.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<postgres-service-host>:5432/guild_points
SPRING_DATASOURCE_USERNAME=guild
SPRING_DATASOURCE_PASSWORD=<strong-password>
JWT_SECRET=<256-bit-random-secret>
CORS_ORIGINS=https://app.seudominio.com
UPLOAD_PATH=/data/uploads
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_FRONTEND_URL=https://app.seudominio.com

# Coolify: mount persistent volume at /data/uploads on the backend container
