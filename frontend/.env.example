# Local dev: leave unset — Vite proxy serves /api and /ws from localhost:8080
# Production (Vercel): set in Project Settings → Environment Variables

VITE_API_BASE_URL=https://api.seudominio.com/api
VITE_WS_BASE_URL=https://api.seudominio.com
# Optional — defaults to API host without /api
# VITE_MEDIA_BASE_URL=https://api.seudominio.com
