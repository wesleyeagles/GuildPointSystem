# Local dev: leave unset — Vite proxy serves /api, /ws, /oauth2 and /login from localhost:8080
# Production (Vercel): copy from deploy/vercel.env.example

VITE_API_BASE_URL=https://backend.guildsystem.com.br/api
VITE_WS_BASE_URL=https://backend.guildsystem.com.br
# Optional — defaults to API host without /api
# VITE_MEDIA_BASE_URL=https://backend.guildsystem.com.br
